{
  "builds": [
    { "src": "web/**", "use": "@vercel/static" },
    { "src": "api/send.py", "use": "@vercel/python" },
    { "src": "api/save.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/save", "dest": "/api/save.py" },
    { "src": "/send", "dest": "/api/send.py" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
